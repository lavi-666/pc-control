# Auto-detect text files and normalize line endings
* text=auto

# Windows shell & PowerShell scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Source code & configs
*.py text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.cs text eol=crlf
*.rs text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary artifacts & assets
*.exe binary
*.apk binary
*.idsig binary
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.dll binary

# Коммит и дата сборки подставляются при скачивании ZIP с GitHub / git archive (сравнение версий при обновлении)
build-info.json export-subst
