+        btn.setAllCaps(false);
+        btn.setGravity(Gravity.CENTER);
+        btn.setMinHeight(dp(Math.max(48, heightDp)));
+
+        GradientDrawable normalBg = createCardBg(bgColor, "#2A3649", 12);
+        btn.setBackground(normalBg);
+        return btn;
+    }
