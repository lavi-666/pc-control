+
+        addView(container, new LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+
+        buildHeader();
+        buildHeroCards();
+        buildVolumeAndMediaCard();
+        buildPowerCard();
+        buildQuickActionsCard();
